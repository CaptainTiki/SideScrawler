code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded, shadows_disabled, ambient_light_disabled, fog_disabled;

uniform sampler2D tex_frg_7;
uniform sampler2D tex_frg_3 : source_color;
uniform sampler2D tex_frg_9;



void fragment() {
// Texture2D:7
	vec4 n_out7p0 = texture(tex_frg_7, UV);


// Input:4
	float n_out4p0 = TIME;


// VectorOp:5
	vec2 n_in5p1 = vec2(2.00000, 0.00000);
	vec2 n_out5p0 = vec2(n_out4p0) * n_in5p1;


// UVFunc:6
	vec2 n_in6p1 = vec2(1.00000, 1.00000);
	vec2 n_out6p0 = n_out5p0 * n_in6p1 + UV;


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, n_out6p0);


// Texture2D:9
	vec4 n_out9p0 = texture(tex_frg_9, UV);


// FloatOp:8
	float n_out8p0 = n_out3p0.x - n_out9p0.x;


// Clamp:10
	float n_in10p1 = 0.00000;
	float n_in10p2 = 1.00000;
	float n_out10p0 = clamp(n_out8p0, n_in10p1, n_in10p2);


// Output:0
	ALBEDO = vec3(n_out7p0.xyz);
	ALPHA = n_out10p0;


}
"
